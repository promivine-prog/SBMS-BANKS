# Which provider runs: "simulated" (default) or "bmoni" (added in the next build)
VITE_PROVIDER=simulated
# Server-only values (Vercel env, never VITE_ prefixed, never committed):
# BMONI_BASE_URL=https://embedded-dev.bmoni.com
# BMONI_API_KEY=
# BMONI_MASTER_KEY=
# ANTHROPIC_API_KEY=

# AI coach (server only). Without it the coach uses labelled rule-based answers.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Free option: Google AI Studio key (preferred if set)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
